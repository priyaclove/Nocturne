# NOCTURNE — environment variables
# Copy this file to `.env.local` and fill in your WordPress/WooCommerce values.
# `.env.local` is gitignored and these values are SERVER-ONLY (no NEXT_PUBLIC_
# prefix), so they never reach the browser.
#
# Until these are set, the storefront automatically uses the bundled demo
# (mock) data — so the site works without WordPress.

# Your WordPress site base URL (no trailing slash)
WORDPRESS_URL="https://your-store.example.com"

# WooCommerce → Settings → Advanced → REST API → Add key (Read permission)
WOOCOMMERCE_KEY="ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOOCOMMERCE_SECRET="cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: how long (seconds) to cache catalog data before refetching
# WORDPRESS_REVALIDATE="300"
